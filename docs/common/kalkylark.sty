% kalkylark.sty - shared style for the Kalkylark documents.
% Built with tectonic (XeTeX). Licensed CC BY 4.0.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kalkylark}[2026/11/19 Kalkylark documentation style]

\RequirePackage[a4paper,margin=25mm,headheight=14pt]{geometry}
\RequirePackage{fontspec}
\setmainfont{texgyrepagella}[
  Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\setsansfont{texgyreheros}[
  Extension=.otf, UprightFont=*-regular, BoldFont=*-bold,
  ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\setmonofont{lmmono10}[
  Extension=.otf, UprightFont=*-regular, BoldFont=lmmonolt10-bold,
  ItalicFont=*-italic]
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{listings}
\RequirePackage[hidelinks]{hyperref}

% ---- colours: the green phosphor theme (theme.c) -------------------------
\definecolor{phbg}{RGB}{6,14,6}
\definecolor{phdim}{RGB}{24,130,24}
\definecolor{phnorm}{RGB}{51,255,51}
\definecolor{phbright}{RGB}{180,255,180}
\definecolor{ink}{RGB}{20,60,20}        % headings on paper
\definecolor{paperbox}{RGB}{238,244,236}

% ---- headings and page style ---------------------------------------------
\titleformat{\section}{\sffamily\Large\bfseries\color{ink}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\sffamily\large\bfseries\color{ink}}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\bfseries\color{ink}}{}{0em}{}
\setlength{\parskip}{0.5\baselineskip}
\setlength{\parindent}{0pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.3pt}
\fancyhead[L]{\sffamily\small\color{ink}Kalkylark}
\fancyhead[R]{\sffamily\small\color{ink}\leftmark}
\fancyfoot[C]{\sffamily\small\thepage}
\renewcommand{\sectionmark}[1]{\markboth{#1}{}}

% ---- screens (generated by tools/screens.py) -----------------------------
% \begin{kscreen}{cols} \kline{runs} ... \end{kscreen}
% runs: \kN \kD \kB (normal/dim/bright text), \kRN \kRD \kRB (reverse video)
\newlength{\kcw}
\newsavebox{\kscreenbox}
\newcommand{\kscreenfont}{\ttfamily\small}
\newcommand{\kstrut}{\rule[-0.27em]{0pt}{1.2em}}
\newcommand{\ks}{\phantom{0}}
\newcommand{\kN}[1]{\textcolor{phnorm}{#1}}
\newcommand{\kD}[1]{\textcolor{phdim}{#1}}
\newcommand{\kB}[1]{\textcolor{phbright}{#1}}
\newcommand{\krev}[2]{{\setlength{\fboxsep}{0pt}\colorbox{#1}{\kstrut\textcolor{phbg}{#2}}}}
\newcommand{\kRN}[1]{\krev{phnorm}{#1}}
\newcommand{\kRD}[1]{\krev{phdim}{#1}}
\newcommand{\kRB}[1]{\krev{phbright}{#1}}
\newcommand{\kline}[1]{\hbox{\kstrut#1}}
\newenvironment{kscreen}[1]{%
  \par\smallskip\begingroup\centering
  \kscreenfont\settowidth{\kcw}{0}%
  \begin{lrbox}{\kscreenbox}%
  \begin{minipage}{#1\kcw}\offinterlineskip}
  {\end{minipage}\end{lrbox}%
  {\setlength{\fboxsep}{6pt}\colorbox{phbg}{\usebox{\kscreenbox}}}%
  \par\endgroup\smallskip}

% \screen{name}{caption}: a generated screen with a caption below it
\newcommand{\screen}[2]{%
  \begin{center}\begin{minipage}{\linewidth}\centering
  \input{#1.tex}%
  {\small\sffamily\color{ink}#2}
  \end{minipage}\end{center}}

% ---- inline notation -----------------------------------------------------
\newcommand{\kbd}[1]{{\setlength{\fboxsep}{1.5pt}\fbox{\ttfamily\small #1}}}
\newcommand{\typ}[1]{\texttt{\color{ink}#1}}     % text you type
\newcommand{\cell}[1]{\textsf{#1}}               % a cell name: A1
\newcommand{\up}{\kbd{$\uparrow$}}
\newcommand{\down}{\kbd{$\downarrow$}}
\newcommand{\lft}{\kbd{$\leftarrow$}}
\newcommand{\rgt}{\kbd{$\rightarrow$}}
\newcommand{\enter}{\kbd{Enter}}
\newcommand{\esc}{\kbd{Esc}}

% a shaded note box
\newenvironment{note}[1][Note]{%
  \par\smallskip\begin{lrbox}{\kscreenbox}\begin{minipage}{\dimexpr\linewidth-16pt}%
  \textsf{\bfseries\color{ink}#1.}\ }
  {\end{minipage}\end{lrbox}%
  \noindent{\setlength{\fboxsep}{8pt}\colorbox{paperbox}{\usebox{\kscreenbox}}}\par\smallskip}

% code excerpts
\lstset{basicstyle=\ttfamily\small, columns=fullflexible, keepspaces=true,
  frame=l, framerule=1.5pt, rulecolor=\color{phdim}, xleftmargin=1.5em,
  framexleftmargin=0.8em, showstringspaces=false, upquote=true}
